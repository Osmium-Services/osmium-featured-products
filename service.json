{
    "id": "osmium-featured-products",
    "name": "Osmium Featured Products",
    "version": "0.1.1",
    "description": "A hand-picked list of up to 5 featured products, ordered by drag and drop in admin, with an edit lock for busy admin teams and the list handed to the theme",
    "category": "shop",
    "author": {
        "name": "Gavin Cox"
    },
    "license": "proprietary",
    "requires": {
        "osmium": ">=1.0.0",
        "php": ">=8.1",
        "services": []
    },
    "autoload": [
        "models"
    ],
    "migrations": "migrations/",
    "hooks": {
        "featured.products": [
            "Osmium\\Services\\FeaturedProducts\\Models\\FeaturedHooks::featuredProducts"
        ],
        "dashboard.widgets": [
            "Osmium\\Services\\FeaturedProducts\\Models\\FeaturedHooks::dashboard"
        ]
    },
    "admin": {
        "menu": {
            "section": "Shop",
            "items": [
                {
                    "id": "featured-products",
                    "label": "Featured Products",
                    "icon": "bx bx-crown",
                    "placement": "top",
                    "route": "admin/featured-products",
                    "activePattern": "admin/featured-products*",
                    "role": null
                }
            ]
        },
        "routes": {
            "admin/featured-products": {
                "controller": "controllers/FeaturedProductsController.php",
                "class": "Osmium\\Services\\FeaturedProducts\\Controllers\\FeaturedProductsController",
                "method": "index",
                "title": "Featured Products"
            },
            "admin/featured-products/action": {
                "controller": "controllers/FeaturedProductsController.php",
                "class": "Osmium\\Services\\FeaturedProducts\\Controllers\\FeaturedProductsController",
                "method": "action"
            }
        }
    },
    "setup": {
        "postInstallNote": "Pick up to 5 products under Shop > Featured Products. Show them from a theme by including the shop's featured-products controller, which gives the page featuredProducts (product cards in your order). Editing locks the page for other admins until you press Save, or after 30 minutes idle."
    }
}
